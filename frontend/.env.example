# Leave empty in local dev (Vite proxies /api to http://localhost:8000).
# In production set it to your deployed API, e.g. https://trade-guard-api.onrender.com
VITE_API_URL=

# Optional Cloudflare Turnstile site key (free). Set the matching TURNSTILE_SECRET on the API to require the human check at sign-up.
VITE_TURNSTILE_SITE_KEY=
