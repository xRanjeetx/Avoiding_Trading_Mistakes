# Copy to .env and fill in. On Render, set these in the dashboard instead.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# ENVIRONMENT=production   # on Render this is set for you; it enforces the checks below at startup
SECRET_KEY=generate-with-python--c-"import secrets;print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:5173  # production: only your https frontend URL, never * or localhost
# TRUSTED_HOSTS=api.example.com  # optional: only answer requests for these Host names
ALLOW_REGISTRATION=true
TOKEN_DAYS=30
# ACCESS_MINUTES=15        # access token lifetime; the app renews it silently
# SESSION_MAX_DAYS=90      # absolute login limit (TOKEN_DAYS above is the idle limit)
# COOKIE_SAMESITE=lax      # production default is none (cross-domain web app + API); strict when /api is proxied through the web host
# REQUIRE_ADMIN_APPROVAL=false   # default is true in production: new sign-ups wait for an admin
# ADMIN_REQUIRE_2FA=false   # default is true in production: admins must turn on two-factor sign-in
# SENTRY_DSN=              # optional error reporting; no request bodies or user details are sent
# LOG_LEVEL=INFO
# MAX_BODY_BYTES=5242880   # largest request body
# PROXY_HOPS=1             # proxies in front of the API (Render: 1); 0 locally. Decides which X-Forwarded-For entry is believed
# RATE_LIMIT_ENABLED=true  # login/sign-up/email limits, counted in memory
# BREACH_CHECK_ENABLED=true  # reject passwords found in known breaches (Have I Been Pwned, only a hash prefix is sent)
# TURNSTILE_SECRET=        # optional Cloudflare Turnstile secret: sign-up and forgot-password then need the human check
